{
  // F5 debugs the file open in the editor (building it first).
  // LeakSanitizer does not work under gdb, hence detect_leaks=0, so it
  // doesn't clutter the output with a warning.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "debug current file",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/${fileBasenameNoExtension}",
      "args": [],
      "cwd": "${workspaceFolder}",
      "environment": [
        { "name": "ASAN_OPTIONS", "value": "detect_leaks=0:detect_stack_use_after_return=1" },
        { "name": "UBSAN_OPTIONS", "value": "print_stacktrace=1" }
      ],
      "MIMode": "gdb",
      "externalConsole": false,
      "preLaunchTask": "build current file",
      "setupCommands": [
        {
          "description": "Readable display of std::string, std::vector, etc.",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
